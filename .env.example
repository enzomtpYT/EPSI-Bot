# Discord Configuration
DISCORD_TOKEN=YOUR_DISCORD_TOKEN

# Timezone (defaults to Europe/Paris)
BOT_TIMEZONE=Europe/Paris

# Database Configuration (Optional: if POSTGRES_HOST is unset, falls back to SQLite automatically)
POSTGRES_DB=epsibot
POSTGRES_USER=epsibot_user
POSTGRES_PASSWORD=secret_password
POSTGRES_HOST=
POSTGRES_PORT=5432
SQLITE_PATH=bot_data.sqlite3