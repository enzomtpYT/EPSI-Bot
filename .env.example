# Discord Configuration
DISCORD_TOKEN=YOUR_DISCORD_TOKEN

# Timezone (defaults to Europe/Paris)
BOT_TIMEZONE=Europe/Paris

# Database Configuration (Optional: if POSTGRES_HOST is unset, falls back to SQLite automatically)
POSTGRES_DB=epsibot
POSTGRES_USER=epsibot_user
POSTGRES_PASSWORD=secret_password
POSTGRES_HOST=
POSTGRES_PORT=5432
SQLITE_PATH=bot_data.sqlite3

# WebUI Configuration
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_BASE_URL=http://localhost:8080

# Discord OAuth2 Configuration (for WebUI login)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8080/auth/callback
SESSION_SECRET=epsi-bot-super-secret-key-change-in-production